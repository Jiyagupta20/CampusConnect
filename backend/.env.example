PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=./config/serviceAccountKey.json

# Option B: Or provide credentials directly via environment variables
FIREBASE_PROJECT_ID=campusconnect-demo
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Master Email for Verification
ADMIN_EMAIL=admin@campusconnect.edu

